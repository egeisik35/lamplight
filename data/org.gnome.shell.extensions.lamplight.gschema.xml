<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.lamplight" path="/org/gnome/shell/extensions/lamplight/">
    <key name="enabled" type="b">
      <default>true</default>
    </key>
    <key name="mode" type="s">
      <choices>
        <choice value="solid"/>
        <choice value="accent"/>
        <choice value="breathe"/>
        <choice value="cycle"/>
        <choice value="rainbow"/>
        <choice value="wave"/>
        <choice value="wheel"/>
        <choice value="gradient"/>
        <choice value="firmware"/>
      </choices>
      <default>'solid'</default>
    </key>
    <key name="color" type="s">
      <default>'ff5500'</default>
    </key>
    <key name="color2" type="s">
      <default>'000000'</default>
    </key>
    <key name="brightness" type="d">
      <range min="0" max="1"/>
      <default>1.0</default>
    </key>
    <key name="speed" type="d">
      <summary>Effect period in seconds</summary>
      <range min="0.5" max="20"/>
      <default>4.0</default>
    </key>
    <key name="direction" type="s">
      <choices>
        <choice value="right"/>
        <choice value="left"/>
        <choice value="down"/>
        <choice value="up"/>
        <choice value="out"/>
        <choice value="in"/>
        <choice value="cw"/>
        <choice value="ccw"/>
      </choices>
      <default>'right'</default>
    </key>
    <key name="off-with-screen" type="b">
      <summary>Turn the lights off while the screen is blanked or locked</summary>
      <default>true</default>
    </key>
    <key name="white-balance" type="(ddd)">
      <summary>Red, green and blue gains (0-1) to match LED colors to the screen</summary>
      <default>(1.0, 1.0, 1.0)</default>
    </key>
    <key name="gamma" type="d">
      <summary>Color response curve; 2.2 matches screens, 1.0 sends raw values</summary>
      <range min="1.0" max="3.0"/>
      <default>2.2</default>
    </key>
    <key name="status" type="s">
      <summary>Written by the service: empty, 'no-device' or 'no-access'</summary>
      <default>''</default>
    </key>
  </schema>
</schemalist>
